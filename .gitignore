node_modules/
.next/
# Windows 上换构建产物要先改名（safe-delete 会超时），这些备份不进仓库
.next.bak*/
out/
build/
dist/

# 本地数据库数据目录（embedded-postgres）
pgdata/
.pgtest/

# 附件上传目录（旧位置，运行时已改到 var/uploads）
public/uploads/
var/uploads/

# 环境变量
.env
.env.local
.env*.local

# 部署脚本在目标机上留的记号（Turbopack 编不过就回退 webpack，别带回仓库）
.build-via-webpack

# 日志
*.log
npm-debug.log*

# 系统
.DS_Store
Thumbs.db

# 测试
coverage/
.vitest/

# agent 的工作区：临时脚本、联调截图、测试用 fixture（pdf/docx/xlsx）、工作笔记，
# 全是过程产物，既不是代码也不是文档，整目录不入库。
# 以前按后缀列黑名单（*.mjs / *.out.txt / shots/ / memory/），结果 fixtures 下的
# 二进制样例差点跟着提交——按后缀枚举永远会漏一个。
.workbuddy/
# 三档视口验收截图（看过就删，不入库）
.tmp-shots/

# TS 增量编译缓存（每次构建都变，入库只会制造无意义的 diff）
tsconfig.tsbuildinfo

# look-and-fix 的截图与 dev 日志：看完就删，不进仓库
.tmp-shots/
.tmp-dev*.log
