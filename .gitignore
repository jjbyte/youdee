node_modules/
.next/
# Windows 上换构建产物要先改名（safe-delete 会超时），这些备份不进仓库
.next.bak*/
out/
build/
dist/

# 本地数据库数据目录（embedded-postgres）
pgdata/
.pgtest/

# 附件上传目录（旧位置，运行时已改到 var/uploads）
public/uploads/
var/uploads/

# 环境变量
.env
.env.local
.env*.local

# 部署脚本在目标机上留的记号（Turbopack 编不过就回退 webpack，别带回仓库）
.build-via-webpack

# 日志
*.log
npm-debug.log*

# 系统
.DS_Store
Thumbs.db

# 测试
coverage/
.vitest/

# 构建/联调期间的临时脚本（agent 产出，非交付物；文件保留在本地但不入库）
.workbuddy/*.mjs
.workbuddy/*.out.txt
# 联调截图（UI 核对用的过程产物）
.workbuddy/shots/
# agent 的工作笔记：本地记录，不是代码也不是文档，不进公开仓库
.workbuddy/memory/

# TS 增量编译缓存（每次构建都变，入库只会制造无意义的 diff）
tsconfig.tsbuildinfo
