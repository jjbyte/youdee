# 部署环境变量模板。复制成 .env 后改值，不要直接把本文件当 .env 用。
#
# 重要：
# 1. JWT_SECRET 必须是随机长串。用模板里那行占位值上线，等于所有人都能伪造登录态。
#    生成：openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-64
# 2. PG_PASSWORD 只用字母数字。它会被拼进 DATABASE_URL，出现 @ : / ? # 会让连接串解析错位，
#    报错信息通常是 "getaddrinfo ENOTFOUND"，很容易被误判成网络问题。
# 3. 附件写在 UPLOAD_DIR（相对工作目录），容器部署时该目录必须挂卷，否则重建镜像就丢文件。

# ── Docker Compose 路径使用 ──────────────────────────────────
PG_USER=youdee
PG_PASSWORD=改成随机字母数字串
PG_DB=youdee
APP_PORT=3000
SEED_ON_BOOT=1
# 构建期 npm 源。留空 = 官方 registry。国内机器拉 500+ 个包常在 registry.npmjs.org
# 上超时（表现为 ETIMEDOUT / ECONNRESET，报错指向某个具体包，容易误判成依赖坏了）。
# 超时就填：NPM_REGISTRY=https://registry.npmmirror.com
NPM_REGISTRY=

# ── 两条路径都需要 ───────────────────────────────────────────
JWT_SECRET=改成随机长串
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
UPLOAD_DIR=var/uploads
MAX_UPLOAD_BYTES=5242880
# 合同附件单份上限（字节）。0 = 不限制（默认）：上传是流式的，几 GB 也不会把内存撑爆。
# 云存储（腾讯云 COS）的密钥在「设置 → 对象存储」里填，不写这里。
MAX_CONTRACT_FILE_BYTES=0

# 会话 Cookie 是否加 Secure。留空 = 按请求实际协议自动判断（http 不加、https 加）。
# 只有当"浏览器→这台机器"这一段是 HTTPS 时才应该加：带 Secure 的 Cookie 在 http 页面上
# 会被浏览器静默丢弃，表现是密码正确、登录接口 200，然后立刻提示「登录已过期，请重新登录」。
# 如果 TLS 在反向代理上终结、但代理没传 X-Forwarded-Proto，就显式设成 1。
# COOKIE_SECURE=

# ── 裸机（不用 Docker）路径使用 ──────────────────────────────
# 容器里 host 是 db；裸机上换成 127.0.0.1 或实际库地址
DATABASE_URL=postgresql://youdee:改成随机字母数字串@127.0.0.1:5432/youdee?schema=public
PORT=3000
# 运行期必须是 production。注意它会连带影响 npm：看到 NODE_ENV=production，npm 就走
# omit=dev 跳过 devDependencies —— 而构建恰恰要用 @tailwindcss/postcss / typescript。
# 所以 manual-deploy.sh 在安装那一步会显式还原成 development 并加 --include=dev；
# 这行本身不要为了装包去改成 development，改了运行期就变成 dev 模式。
NODE_ENV=production
