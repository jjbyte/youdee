# ── 数据库（本地 embedded-postgres，端口 55432）────────────────
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/youdee?schema=public"
PG_PORT=55432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=youdee

# ── 认证 ──────────────────────────────────────────────────────
# 生产必须替换为 32 字节以上随机串：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="请替换为 32 字节以上随机串：node -e \"console.log(require('crypto').randomBytes(48).toString('base64url'))\""
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# ── 附件 ──────────────────────────────────────────────────────
UPLOAD_DIR="var/uploads"
MAX_UPLOAD_BYTES=5242880
# 合同附件单份上限（字节）。0 = 不限制：上传走流式，大文件不占内存。
# 云存储的密钥不在这里配——在「设置 → 对象存储」里填，改完即时生效、不用重启。
MAX_CONTRACT_FILE_BYTES=0

# ── 业务默认值（对应 app_settings 种子，运行期以数据库为准）────
DEFAULT_MARGIN_WARN_RATE=0.25
STALE_DAYS_THRESHOLD=90
TAX_STATEMENT_DEFAULT=inclusive

# ── 运行环境 ──────────────────────────────────────────────────
NODE_ENV=development
